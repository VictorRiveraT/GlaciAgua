# ========================================================
# ARCHIVO DE CONFIGURACIÓN DE ENTORNO - GLACIAGUA
# ========================================================

# Microservicio Machine Learning (por defecto http://api:8001 dentro de Docker)
ML_API_URL=http://api:8001

# --------------------------------------------------------
# SERVIDOR SMTP PARA ENVÍO DE CORREOS Y OFICIOS COMUNITARIOS
# --------------------------------------------------------
# Si deja estos campos vacíos, GlaciAgua operará en "modo simulado",
# registrando los correos en consola sin fallar en entornos locales.

# Ejemplo con Resend (Recomendado para dominios personalizados, 3,000 correos gratis/mes):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_123456789abc...
# EMAIL_FROM=alertas@tudominio.pe
# SMTP_USE_TLS=true

# Ejemplo con Brevo (Antes Sendinblue - 300 correos gratis/día):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=tu-cuenta@tudominio.pe
# SMTP_PASSWORD=tu-master-password
# EMAIL_FROM=alertas@tudominio.pe

# Ejemplo con Gmail / Google Workspace (Requiere Contraseña de Aplicación de 16 letras):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# EMAIL_FROM=tu-correo@gmail.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=alertas@glaciagua.pe
SMTP_USE_TLS=true
